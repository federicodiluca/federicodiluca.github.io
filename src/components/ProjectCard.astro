---
interface Props {
  name: string;
  /** Percorso al logo del progetto (SVG in /projects/). */
  icon: string;
  tagline: string;
  description: string;
  stack: readonly string[];
  url: string;
  repo: string;
  cta: string;
  /** Su /progetti/ la descrizione è per esteso; in home resta compatta. */
  compact?: boolean;
}

const { name, icon, tagline, description, stack, url, repo, cta, compact = false } = Astro.props;
---

<article class:list={["card project-card", { compact }]}>
  <header class="project-head">
    <img class="project-icon" src={icon} alt="" width="48" height="48" loading="lazy" />
    <div>
      <h3 class="project-name">{name}</h3>
      <p class="project-tagline">{tagline}</p>
    </div>
  </header>

  <p class="project-description">{description}</p>

  {/* In home la card è un'anteprima: le tecnologie si leggono su /progetti/. */}
  {!compact && (
    <ul class="project-stack">
      {stack.map((tech) => <li>{tech}</li>)}
    </ul>
  )}

  <div class="project-actions">
    <a class="btn btn-primary" href={url} target="_blank" rel="noopener noreferrer">{cta}</a>
    <a class="project-repo" href={repo} target="_blank" rel="noopener noreferrer">{compact ? "GitHub" : "Codice su GitHub"}</a>
  </div>
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .project-head {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    margin-bottom: 1rem;
  }

  /* I loghi hanno un fondo pieno proprio: l'angolo arrotondato li fa leggere
     come icone dell'app, non come immagini incollate nella card. */
  .project-icon {
    width: 3rem;
    height: 3rem;
    flex-shrink: 0;
    border-radius: 0.6rem;
    border: 1px solid var(--color-border);
  }

  .project-name {
    margin: 0;
    font-size: 1.25rem;
  }

  .project-tagline {
    margin: 0.15rem 0 0;
    color: var(--color-link);
    font-size: 0.9rem;
    font-weight: 600;
  }

  .project-description {
    color: var(--color-text-muted);
    margin: 0 0 1.25rem;
    flex-grow: 1;
  }

  /* Niente flex-grow qui: allungherebbe il box oltre le tre righe e il taglio si vedrebbe a metà. */
  .compact .project-description {
    flex-grow: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .project-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 0 0 1.25rem;
    padding: 0;
  }

  .project-stack li {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--color-text-muted);
    background: var(--color-bg-alt);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 999px;
    padding: 0.2rem 0.6rem;
  }

  .project-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-top: auto;
  }

  .project-repo {
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  .project-repo:hover {
    color: var(--color-text);
  }
</style>
