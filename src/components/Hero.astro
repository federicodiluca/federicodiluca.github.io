---
interface CTA {
  href: string;
  label: string;
  icon?: "mail" | "download";
}

interface Props {
  eyebrow?: string;
  title: string;
  /** Parte del titolo da colorare con la sfumatura del brand (deve comparire nel titolo). */
  highlight?: string;
  tagline: string;
  primaryCta?: CTA;
  secondaryCta?: CTA;
}
const { eyebrow, title, highlight, tagline, primaryCta, secondaryCta } = Astro.props;
const [before, after] = highlight && title.includes(highlight) ? title.split(highlight) : [title, undefined];

const getIcon = (type?: string) => {
  if (type === "mail") {
    return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>';
  }
  if (type === "download") {
    return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>';
  }
  return "";
};

function starLayer(count: number, maxW: number, maxH: number) {
  const shadows: string[] = [];
  for (let i = 0; i < count; i++) {
    const x = Math.floor(Math.random() * maxW);
    const y = Math.floor(Math.random() * maxH);
    shadows.push(`${x}px ${y}px #fff`);
  }
  return shadows.join(", ");
}

const hasAside = Astro.slots.has("aside");

const smallStars = starLayer(90, 1600, 900);
const bigStars = starLayer(35, 1600, 900);
---

<section class="hero theme-dark">
  <div class="stars stars-sm" style={{ boxShadow: smallStars }}></div>
  <div class="stars stars-lg" style={{ boxShadow: bigStars }}></div>
  <div class:list={["container", "hero-inner", { "has-aside": hasAside }]}>
    <div class="hero-text">
    {eyebrow && <p class="hero-eyebrow">{eyebrow}</p>}
    <h1 class="hero-title">
      {before}{after !== undefined && <span class="hero-highlight">{highlight}</span>}{after}
    </h1>
    <p class="hero-tagline">{tagline}</p>
    <div class="hero-actions">
      {primaryCta && (
        <a class="btn btn-primary" href={primaryCta.href}>
          {primaryCta.icon && <span class="btn-icon" set:html={getIcon(primaryCta.icon)} />}
          {primaryCta.label}
        </a>
      )}
      {secondaryCta && (
        <a class="btn btn-outline" href={secondaryCta.href}>
          {secondaryCta.icon && <span class="btn-icon" set:html={getIcon(secondaryCta.icon)} />}
          {secondaryCta.label}
        </a>
      )}
    </div>
    </div>
    {hasAside && (
      <div class="hero-aside">
        <slot name="aside" />
      </div>
    )}
  </div>
</section>

<style>
  /* Fondo scuro (anche nel tema chiaro, via .theme-dark) con due bagliori del brand e le stelle */
  .hero {
    position: relative;
    overflow: hidden;
    padding: 8rem 0 7rem;
    background:
      radial-gradient(48rem 30rem at 85% 15%, color-mix(in srgb, var(--color-accent) 34%, transparent), transparent 70%),
      radial-gradient(40rem 26rem at 5% 100%, color-mix(in srgb, var(--color-accent-3) 20%, transparent), transparent 70%),
      var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }

  .stars {
    position: absolute;
    top: 0;
    left: 0;
    width: 2px;
    height: 2px;
    border-radius: 50%;
    background: transparent;
    animation: floatUp 8s ease-in infinite;
  }

  .stars-sm {
    animation: floatUp 8s ease-in infinite, twinkle 6s ease-in-out infinite alternate;
  }

  .stars-lg {
    width: 3px;
    height: 3px;
    opacity: 0.8;
    animation: floatUp 10s ease-in infinite, twinkle 6s ease-in-out infinite alternate;
  }

  @keyframes floatUp {
    from { transform: translateY(0); opacity: 0; }
    50% { opacity: 1; }
    to { transform: translateY(-900px); opacity: 0; }
  }

  @keyframes twinkle {
    from { opacity: 0.35; }
    to { opacity: 0.9; }
  }

  .hero-inner {
    position: relative;
    text-align: center;
    z-index: 1;
  }

  /* Con la foto accanto il testo si allinea a sinistra, come nelle intestazioni delle pagine interne */
  .hero-inner.has-aside {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: 3rem;
    align-items: center;
    text-align: left;
  }

  .has-aside .hero-title {
    font-size: clamp(2.4rem, 5vw, 3.6rem);
  }

  .has-aside .hero-tagline {
    margin-left: 0;
  }

  .has-aside .hero-actions {
    justify-content: flex-start;
  }

  .hero-eyebrow {
    color: var(--color-link);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 1rem;
  }

  .hero-highlight {
    background: linear-gradient(135deg, #b794f6, var(--color-accent-3));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero-title {
    font-size: clamp(2.8rem, 7vw, 4.5rem);
    color: #fff;
    margin: 0 0 1rem;
  }

  .hero-tagline {
    color: var(--color-text-muted);
    font-size: 1.25rem;
    max-width: 40rem;
    margin: 0 auto 2.5rem;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  @media (max-width: 860px) {
    .hero {
      padding: 7rem 0 5rem;
    }

    .hero-inner.has-aside {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .hero-aside {
      order: -1;
    }
  }

  .hero .btn-outline {
    border-color: rgba(255, 255, 255, 0.6);
  }

  .btn-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1em;
    height: 1em;
    flex-shrink: 0;
    vertical-align: middle;
  }

  .btn-icon svg {
    width: 0.75em;
    height: 0.75em;
    display: block;
  }
</style>
