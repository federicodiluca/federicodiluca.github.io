  globe: `<path class="f" d="M12 3c2.5 2.5 3.8 5.5 3.8 9s-1.3 6.5-3.8 9c-2.5-2.5-3.8-5.5-3.8-9S9.5 5.5 12 3z"/><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.5 3.8 5.5 3.8 9s-1.3 6.5-3.8 9c-2.5-2.5-3.8-5.5-3.8-9S9.5 5.5 12 3z"/>`,
  automation: `<path class="f" d="M13 7l-4 6h3l-1 4 4-6h-3z"/><path d="M20 12a8 8 0 0 1-13.7 5.6M4 12a8 8 0 0 1 13.7-5.6M18 3v3.6h-3.6M6 21v-3.6h3.6"/><path class="a" d="M13 7l-4 6h3l-1 4 4-6h-3z"/>`,
  compass: `<path class="f" d="M15.5 8.5l-2 5-5 2 2-5z"/><circle cx="12" cy="12" r="9"/><path d="M15.5 8.5l-2 5-5 2 2-5z"/><circle class="d" cx="12" cy="12" r="1"/>`,
  team: `<circle class="f" cx="9" cy="8" r="3"/><circle cx="9" cy="8" r="3"/><path d="M3.5 19a5.5 5.5 0 0 1 11 0M15.5 5.2a3 3 0 0 1 0 5.6M17 14.2a5.5 5.5 0 0 1 3.5 4.8"/>`,
  building: `<path class="f" d="M15 10h4a1 1 0 0 1 1 1v10h-5z"/><path d="M4 21V5a1 1 0 0 1 1-1h9a1 1 0 0 1 1 1v16M15 10h4a1 1 0 0 1 1 1v10M2.5 21h19M8 8h3M8 12h3M8 16h3"/>`,
  flow: `<path class="f" d="M12 10l4 3-4 3-4-3z"/><rect x="9" y="2.5" width="6" height="4.5" rx="1"/><path d="M12 7v3M12 10l4 3-4 3-4-3zM8 13H5v4M16 13h3v4"/><rect x="2.5" y="17" width="5" height="4.5" rx="1"/><rect x="16.5" y="17" width="5" height="4.5" rx="1"/>`,
  cap: `<path class="f" d="M12 4 2 9l10 5 10-5z"/><path d="M12 4 2 9l10 5 10-5zM6 11v5c0 1.7 2.7 3 6 3s6-1.3 6-3v-5M22 9v6"/>`,
  cpu: `<rect class="f" x="9" y="9" width="6" height="6" rx="1"/><rect x="5" y="5" width="14" height="14" rx="2"/><rect x="9" y="9" width="6" height="6" rx="1"/><path d="M9 2v3M15 2v3M9 19v3M15 19v3M2 9h3M2 15h3M19 9h3M19 15h3"/>`,
  chart: `<path class="f" d="M4 17c3 0 4-10 8-10s5 7 8 7v6H4z"/><path d="M3 20h18M4 3v18"/><path class="a" d="M4 17c3 0 4-10 8-10s5 7 8 7"/>`,
  atom: `<circle class="f" cx="12" cy="12" r="3"/><ellipse cx="12" cy="12" rx="10" ry="4"/><ellipse cx="12" cy="12" rx="10" ry="4" transform="rotate(60 12 12)"/><ellipse cx="12" cy="12" rx="10" ry="4" transform="rotate(120 12 12)"/><circle class="d" cx="12" cy="12" r="1.3"/>`,
  network: `<path class="a" d="M4 5L12 8.5M4 5L12 15.5M4 12L12 8.5M4 12L12 15.5M4 19L12 8.5M4 19L12 15.5M12 8.5L20 12M12 15.5L20 12"/><circle class="d" cx="4" cy="5" r="1.5"/><circle class="d" cx="4" cy="12" r="1.5"/><circle class="d" cx="4" cy="19" r="1.5"/><circle class="d" cx="12" cy="8.5" r="1.5"/><circle class="d" cx="12" cy="15.5" r="1.5"/><circle class="f" cx="20" cy="12" r="3"/><circle class="d" cx="20" cy="12" r="1.7"/>`,
  factory: `<path class="f" d="M17.5 4H21v17h-3.5z"/><path d="M2.5 21V11l5 3v-3l5 3v-3l5 3V4H21v17zM6 17.5h2M11 17.5h2"/>`,
  backpack: `<path class="f" d="M8 13h8v4a1 1 0 0 1-1 1H9a1 1 0 0 1-1-1z"/><path d="M9 6V4.5A1.5 1.5 0 0 1 10.5 3h3A1.5 1.5 0 0 1 15 4.5V6"/><rect x="5" y="6" width="14" height="15" rx="4"/><path d="M8 13h8v4a1 1 0 0 1-1 1H9a1 1 0 0 1-1-1z"/>`,
  school: `<path class="f" d="M5 10l7-5 7 5z"/><path d="M3 21h18M5 21V10l7-5 7 5v11M10 21v-5h4v5"/><circle cx="12" cy="11" r="1.5"/>`,
  terminal: `<rect class="f" x="3" y="4" width="18" height="16" rx="2"/><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 9l3 3-3 3"/><path class="a" d="M12.5 15H17"/>`,
