---
// Icone disegnate su griglia 24×24, in stile "duotone": il tratto prende currentColor,
// le forme con classe `f` sono un riempimento viola trasparente, `d` un pieno e `a` un
// tratto nel colore d'accento. L'ordine conta: i riempimenti vanno prima dei tratti.
const icons = {
  code: `<path class="f" d="M3 6a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v3H3z"/><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M10 12.5l-2 2 2 2M14 12.5l2 2-2 2"/>`,
  board: `<rect class="f" x="4" y="4" width="16" height="11"/><path d="M2.5 4h19M4 4v11h16V4M12 15v3M8.5 21l3.5-3 3.5 3"/><path class="a" d="M7.5 11.5l3-3 2 2 4-4"/>`,
