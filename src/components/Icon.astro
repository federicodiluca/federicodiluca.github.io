  paper: `<path class="f" d="M14 3v4h4z"/><path d="M6 3h8l4 4v14H6zM14 3v4h4M9 12h6M9 16h6"/>`,
  check: `<circle class="f" cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="9"/><path class="a" d="M8 12.5l2.5 2.5L16 9.5"/>`,
  spark: `<path class="f" d="M11 3l1.8 5.2L18 10l-5.2 1.8L11 17l-1.8-5.2L4 10l5.2-1.8z"/><path d="M11 3l1.8 5.2L18 10l-5.2 1.8L11 17l-1.8-5.2L4 10l5.2-1.8z"/><path class="a" d="M19 15v5M16.5 17.5h5"/>`,
  download: `<path class="f" d="M4 16h16v3a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2z"/><path d="M12 3v12M7 10l5 5 5-5M4 16v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-3"/>`,
  arrow: `<path d="M5 12h14M13 6l6 6-6 6"/>`,
} as const;

export type IconName = keyof typeof icons;

interface Props {
  name: IconName;
  /** Racchiude l'icona in un riquadro sfumato, per card e intestazioni. */
  badge?: boolean;
  class?: string;
}
const { name, badge = false, class: className } = Astro.props;
const svg = `<svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">${icons[name]}</svg>`;
---

<span class:list={[badge ? "icon-badge" : "icon-inline", className]} aria-hidden="true" set:html={svg} />

<style>
  .icon-inline,
  .icon-badge {
    display: inline-grid;
    place-items: center;
    flex-shrink: 0;
    color: var(--icon-color, var(--color-icon));
  }

  .icon-inline {
    width: 1.25em;
    height: 1.25em;
    vertical-align: -0.25em;
  }

  .icon-badge {
    width: 3rem;
    height: 3rem;
    border-radius: 0.9rem;
    font-size: 1.75rem;
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--color-accent) 22%, transparent),
      color-mix(in srgb, var(--color-accent-3) 22%, transparent)
    );
    border: 1px solid color-mix(in srgb, var(--color-accent) 30%, transparent);
    transition: transform 0.25s ease;
  }


  :global(.card:hover) .icon-badge {
    transform: translateY(-2px) rotate(-6deg);
  }

  .icon-inline :global(.icon),
  .icon-badge :global(.icon) {
    width: 1em;
    height: 1em;
    overflow: visible;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .icon-inline :global(.icon) {
    width: 100%;
    height: 100%;
  }

  :global(.icon .f) {
    fill: var(--color-accent-3);
    fill-opacity: 0.4;
    stroke: none;
  }

  :global(.icon .d) {
    fill: currentColor;
    stroke: none;
  }

  :global(.icon .a) {
    stroke: var(--color-icon-accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .icon-badge {
      transition: none;
    }
  }
</style>
