  target: `<circle class="f" cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle class="d" cx="12" cy="12" r="1.5"/>`,
  rocket: `<path class="f" d="M12 2.5c3 2 4.5 5 4.5 8.5v4.5h-9V11c0-3.5 1.5-6.5 4.5-8.5z"/><path d="M12 2.5c3 2 4.5 5 4.5 8.5v4.5h-9V11c0-3.5 1.5-6.5 4.5-8.5zM7.5 12 5 14.5V18l2.5-1.5M16.5 12l2.5 2.5V18l-2.5-1.5"/><circle cx="12" cy="9" r="1.8"/><path class="a" d="M10.5 18.5c0 1.5.7 2.6 1.5 3.5.8-.9 1.5-2 1.5-3.5"/>`,
