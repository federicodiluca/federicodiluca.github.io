---
import { SITE_URL, SITE_NAME, AUTHOR, GOOGLE_SITE_VERIFICATION } from "../consts";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  locale?: "it" | "en";
  image?: string;
  type?: "website" | "article";
  noIndex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  locale = "it",
  image = "/images/social-share.jpg",
  type = "website",
  noIndex = false,
  jsonLd,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, SITE_URL).toString();
const imageURL = new URL(image, SITE_URL).toString();
// Un titolo che comincia già col nome (la home) non riceve il suffisso " · Nome".
const fullTitle = title.startsWith(SITE_NAME) ? title : `${title} · ${SITE_NAME}`;

// Solo le pagine elencate qui hanno una vera controparte tradotta: un hreflang che punta
// a una pagina inesistente (es. /en/chi-sono/, mai creata) è peggio che non averlo.
const IT_TO_EN_PATHS: Record<string, string> = {
  "/": "/en/",
  "/contatti/": "/en/contact/",
  "/privacy/": "/en/privacy/",
};
const EN_TO_IT_PATHS: Record<string, string> = Object.fromEntries(
  Object.entries(IT_TO_EN_PATHS).map(([it, en]) => [en, it]),
);

const currentPath = Astro.url.pathname;
const itPath = locale === "en" ? EN_TO_IT_PATHS[currentPath] : currentPath;
const enPath = locale === "en" ? currentPath : IT_TO_EN_PATHS[currentPath];
const hasTranslation = Boolean(itPath && enPath);

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${SITE_URL}/#person`,
  name: AUTHOR.name,
  email: `mailto:${AUTHOR.email}`,
  jobTitle: AUTHOR.jobTitle,
  url: SITE_URL,
  image: imageURL,
  address: {
    "@type": "PostalAddress",
    addressLocality: AUTHOR.city,
    addressRegion: AUTHOR.region,
    addressCountry: AUTHOR.country,
  },
  sameAs: AUTHOR.sameAs,
};

const schemas = [personSchema, ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];
---

<!DOCTYPE html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- .ico per i browser vecchi; i moderni scelgono l'SVG (dichiarare l'ico 32x32 evita che Chrome lo preferisca) -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="canonical" href={canonicalURL} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex, follow" />}

    {hasTranslation && (
      <>
        <link rel="alternate" hreflang="it" href={new URL(itPath, SITE_URL).toString()} />
        <link rel="alternate" hreflang="en" href={new URL(enPath, SITE_URL).toString()} />
        <link rel="alternate" hreflang="x-default" href={new URL(itPath, SITE_URL).toString()} />
      </>
    )}

    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content={locale === "it" ? "it_IT" : "en_US"} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    <meta name="google-site-verification" content={GOOGLE_SITE_VERIFICATION} />

    {schemas.map((schema) => (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
    ))}

    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#0d0b1f" />
  </head>
  <body>
    <Header locale={locale} />
    <main>
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>

<style is:global>
  /* Palette: il viola è il colore del brand (pulsanti, link, icone), l'orchidea lo accompagna
     nelle sfumature, il teal resta solo come scintilla nei dettagli delle icone.
     .theme-dark ridichiara i token scuri: le fasce che lo usano (hero, intestazioni,
     riquadro finale) restano scure anche nel tema chiaro. */
  :root,
  .theme-dark {
    --color-bg: #0d0b1f;
    --color-bg-alt: #141130;
    --color-surface: #1b1740;
    --color-text: #ece9f7;
    --color-text-muted: #aba6c8;
    --color-link: #c4b5fd;
    --color-icon: #c4b5fd;
    --color-icon-accent: #2dd4bf;
    --color-rose: #f472b6;
    --color-border: rgba(255, 255, 255, 0.08);
    --color-border-strong: rgba(255, 255, 255, 0.35);
    --shadow-card: none;
  }

  :root {
    --color-accent: #8b5cf6;
    --color-accent-hover: #7c4dea;
    --color-accent-2: #2dd4bf;
    --color-accent-3: #d46bd9;
    --gradient-brand: linear-gradient(135deg, var(--color-accent), var(--color-accent-3));
    --max-width: 72rem;
    --radius: 0.75rem;
    font-size: 16px;
  }

  :root.light {
    --color-bg: #ffffff;
    --color-bg-alt: #f7f5fc;
    --color-surface: #ffffff;
    --color-text: #1c1733;
    --color-text-muted: #5f5a7a;
    --color-link: #6d28d9;
    --color-icon: #7c3aed;
    --color-icon-accent: #0d9488;
    --color-rose: #db2777;
    --color-border: rgba(28, 23, 51, 0.1);
    --color-border-strong: rgba(28, 23, 51, 0.28);
    --shadow-card: 0 1px 2px rgba(28, 23, 51, 0.04), 0 12px 32px -20px rgba(76, 29, 149, 0.28);
  }

  .theme-dark {
    color: var(--color-text);
    background-color: var(--color-bg);
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    padding: 0;
  }

  body {
    background: var(--color-bg);
    color: var(--color-text);
    font-family: "Segoe UI", system-ui, -apple-system, Roboto, Helvetica, Arial, sans-serif;
    line-height: 1.6;
  }

  h1,
  h2,
  h3,
  h4 {
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  a {
    color: var(--color-link);
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }

  img {
    max-width: 100%;
    display: block;
  }

  .container {
    width: 100%;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .section {
    padding: 4.5rem 0;
  }

  .section-title {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    margin: 0 0 0.75rem;
  }

  /* Senza sottotitolo, quello che segue un titolo di sezione (griglie, liste, testo)
     avrebbe solo il margine pensato per il lead: gli si dà respiro. */
  .section-title + :not(.section-lead) {
    margin-top: 1.5rem;
  }

  .section-lead {
    color: var(--color-text-muted);
    font-size: 1.125rem;
    max-width: 42rem;
    margin: 0 0 2.5rem;
  }

  .card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-card);
    padding: 1.75rem;
  }

  /* inline-flex + gap: le icone dentro i pulsanti hanno sempre la stessa distanza dal testo */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    padding: 0.75rem 1.5rem;
    border-radius: 999px;
    font-weight: 600;
    border: 1px solid transparent;
    transition: transform 0.15s ease, background-color 0.15s ease, box-shadow 0.15s ease;
  }

  /* Un pulsante subito dopo un paragrafo di testo ne restava troppo a ridosso */
  p:not(.section-lead) + .btn {
    margin-top: 0.75rem;
  }

  .btn:hover {
    transform: translateY(-1px);
    text-decoration: none;
  }

  .btn-primary {
    background: var(--color-accent);
    color: #fff;
    box-shadow: 0 0.6rem 1.5rem -0.75rem color-mix(in srgb, var(--color-accent) 80%, transparent);
  }

  .btn-primary:hover {
    background: var(--color-accent-hover);
  }

  .btn-outline {
    border-color: var(--color-border-strong);
    color: var(--color-text);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  [data-animate] {
    opacity: 0;
    animation: fadeInUp 0.6s ease-out forwards;
  }

  [data-animate="delayed"] {
    animation-delay: 0.2s;
  }
</style>

<script>
  const observerOptions = {
    threshold: 0.1,
    rootMargin: "0px 0px -50px 0px",
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add("in-view");
        observer.unobserve(entry.target);
      }
    });
  }, observerOptions);

  document.querySelectorAll("[data-animate]").forEach((el) => {
    observer.observe(el);
    el.classList.add("animating");
  });

  document.addEventListener("astro:after-swap", () => {
    document.querySelectorAll("[data-animate]").forEach((el) => {
      if (!el.classList.contains("animating")) {
        observer.observe(el);
        el.classList.add("animating");
      }
    });
  });
</script>
