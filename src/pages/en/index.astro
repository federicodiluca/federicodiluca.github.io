</BaseLayout>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  .about-text {
    color: var(--color-text-muted);
  }

  .about-photo {
    border-radius: var(--radius);
    width: 100%;
    max-width: 320px;
    margin: 0 auto;
  }

  .narrow {
    max-width: 42rem;
  }

  .narrow p {
    color: var(--color-text-muted);
  }

  .section-alt {
    background: var(--color-bg-alt);
  }

  .experiences-footer {
    margin-top: 2rem;
    color: var(--color-text-muted);
    font-size: 0.85rem;
    line-height: 1.8;
  }

  .publication-card {
    display: block;
    color: var(--color-text);
  }

  .publication-journal {
    color: var(--color-accent-2);
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    margin: 0 0 0.5rem;
  }

  .publication-title {
    margin: 0;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .service-card {
    background: var(--color-surface);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius);
    padding: 1.5rem;
  }

  .service-card h3 {
    color: var(--color-text);
    margin-top: 0;
    margin-bottom: 0.75rem;
  }

  .service-card p {
    color: var(--color-text-muted);
    margin: 0;
  }

  .cta-section {
    text-align: center;
  }

  .cta-inner .section-title {
    margin-bottom: 0.5rem;
  }

  .cta-inner .section-lead {
    margin: 0 auto 2rem;
  }

  @media (max-width: 720px) {
    .about-grid {
      grid-template-columns: 1fr;
    }

    .about-photo {
      order: -1;
    }
  }
</style>
