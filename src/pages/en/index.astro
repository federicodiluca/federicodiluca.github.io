---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import Timeline from "../../components/Timeline.astro";
import SkillsGrid from "../../components/SkillsGrid.astro";
import Icon from "../../components/Icon.astro";
import Portrait from "../../components/Portrait.astro";
import CtaBand from "../../components/CtaBand.astro";
import { experiences, education, publications } from "../../data/site-data";
import { SITE_URL, SITE_NAME, AUTHOR, SHOW_PRIVATE_LESSONS } from "../../consts";

const description =
  "Federico Di Luca: freelance software developer (.NET, C#, Python) and Computer Science teacher based in Pesaro, Italy.";

const translations: Record<string, string> = {
  "Docente di Informatica": "Computer Science Teacher",
  "Docente di Informatica & Formatore STEM": "Computer Science Teacher & STEM Trainer",
  "Laurea Magistrale": "Master's Degree",
  "Laurea Triennale": "Bachelor's Degree",
  "Ingegneria Elettronica e delle Telecomunicazioni": "Electronic and Telecommunications Engineering",
  "Ingegneria Biomedica": "Biomedical Engineering",
  "Università di Bologna": "University of Bologna",
  "Universitat Politècnica de Catalunya, Barcellona": "Universitat Politècnica de Catalunya, Barcelona",
  "Primo semestre del secondo anno": "First semester of the second year",
  "Settembre 2025 – Presente": "September 2025 – Present",
  "Anno scolastico 2024–2025": "School year 2024–2025",
  "Maggio 2021 – Dicembre 2024": "May 2021 – December 2024",
  "Gennaio 2020 – Aprile 2021": "January 2020 – April 2021",
  "Settembre 2017 – Dicembre 2019": "September 2017 – December 2019",
  "Settembre 2014 – Luglio 2017": "September 2014 – July 2017",
  "Settembre 2018 – Febbraio 2019": "September 2018 – February 2019",
};
const t = (it: string) => translations[it] ?? it;

// Work and education in a single timeline, most recent first.
const path = [
  ...experiences.map((e) => ({
    kind: "work" as const,
    start: e.start,
    title: t(e.role),
    subtitle: e.company,
    date: t(e.date),
  })),
  ...education.map((e) => ({
    kind: "education" as const,
    start: e.start,
    title: `${t(e.title)} in ${t(e.subTitle)}`,
    subtitle: t(e.institute),
    meta: `Grade: ${e.mark}`,
    date: t(e.date),
    steps: e.steps.map((s) => ({ title: s.title, subtitle: t(s.institute), meta: t(s.note), date: t(s.date) })),
  })),
].sort((a, b) => b.start.localeCompare(a.start));

const highlights = [
  { icon: "cap" as const, title: "110 cum laude", text: "Master's degree in Electronic and Telecommunications Engineering, Bologna" },
  { icon: "paper" as const, title: "Research", text: "Human detection with UWB radar, published in MDPI Sensors" },
  { icon: "team" as const, title: "Technical Leader", text: ".NET development teams at Websolute, 2021–2024" },
  { icon: "board" as const, title: "Teacher", text: "Computer Science in high school, since 2024" },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: `${AUTHOR.name} — Software Development & ${SHOW_PRIVATE_LESSONS ? "Private Lessons" : "Training"}`,
  url: new URL("/en/", SITE_URL).toString(),
  image: new URL("/images/social-share.jpg", SITE_URL).toString(),
  areaServed: AUTHOR.serviceArea,
  founder: { "@id": `${SITE_URL}/#person` },
  address: {
    "@type": "PostalAddress",
    addressLocality: AUTHOR.city,
    addressRegion: AUTHOR.region,
    addressCountry: AUTHOR.country,
  },
};
---

<BaseLayout title={`${SITE_NAME} · Freelance software developer & CS teacher`} description={description} locale="en" jsonLd={jsonLd}>
  <Hero
    eyebrow="Hi, I'm Federico Di Luca"
    title="Freelance Software Developer & Computer Science Teacher"
    highlight="Computer Science Teacher"
    tagline="Custom software development, technical consulting, programming education and training for companies, schools and universities."
    primaryCta={{ href: "/en/contact/", label: "Contact me", icon: "mail" }}
    secondaryCta={{ href: "/cv-federico-di-luca.pdf", label: "Download CV", icon: "download" }}
  >
    <Portrait slot="aside" />
  </Hero>

  <section class="section">
    <div class="container">
      <h2 class="section-title">Services</h2>
      <p class="section-lead">Custom software solutions, technical expertise, and technical training for companies and educational institutions.</p>
      <div class="services-grid">
        <div class="service-card">
          <Icon name="code" badge class="service-icon" />
          <h3>Software Development</h3>
          <p>Backend architecture, web applications, system design, and technical consulting for startups and established companies.</p>
        </div>
        <div class="service-card">
          <Icon name="board" badge class="service-icon" />
          <h3>Technical Training</h3>
          <p>Programming courses, computer science education, and team upskilling in modern technologies and best practices.</p>
        </div>
        <div class="service-card">
          <Icon name="factory" badge class="service-icon" />
          <h3>Industrial Automation</h3>
          <p>SCADA systems, PLC programming, and automation solutions for manufacturing and warehouse management.</p>
        </div>
        <div class="service-card">
          <Icon name="network" badge class="service-icon" />
          <h3>Machine Learning</h3>
          <p>ML model development for classification, regression, and predictive analytics. Research and development support.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt" id="about">
    <div class="container about-grid">
      <div>
        <h2 class="section-title">About me</h2>
        <p class="about-text">
          I'm a Computer Science teacher and former .NET Technical Leader with 5+ years of experience developing web solutions for Brand, Marketing and E-commerce clients. Throughout my career, I have led development teams, designed software architectures, and managed end-to-end IT projects.
        </p>
        <p class="about-text">
          Today I combine my technical expertise with a strong passion for education. I teach Computer Science at high schools and provide technical consulting and training for companies seeking to build or scale their development teams.
        </p>
        <p class="about-text">
          I offer expertise in SCADA systems for industrial automation, machine learning models for classification and regression, backend architecture design, and concurrent programming. Available for project-based collaborations.
        </p>
        <a class="btn btn-outline" href="/chi-sono/" hreflang="it">Full story (in Italian) <Icon name="arrow" /></a>
      </div>
      <ul class="highlights">
        {highlights.map((h) => (
          <li class="card highlight">
            <Icon name={h.icon} badge />
            <p class="highlight-title">{h.title}</p>
            <p class="highlight-text">{h.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title">Core Technologies</h2>
      <SkillsGrid />
    </div>
  </section>

  <section class="section section-alt" id="career">
    <div class="container">
      <h2 class="section-title">Career path</h2>
      <p class="section-lead">From engineering to software development, and on to teaching.</p>
      <Timeline items={path} legend={{ work: "Work", education: "Education" }} />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title">Research & Publications</h2>
      <p class="section-lead">Peer-reviewed research in machine learning, signal processing, and industrial automation.</p>
      <div>
        {publications.map((pub) => {
          const abstractTranslations: any = {
            "Lo studio analizza il rilevamento di persone in condizioni non-line-of-sight (NLOS) tramite radar ultra-wideband, attraverso una campagna di misurazioni in ambienti reali con orientamenti del corpo, materiali degli ostacoli e distanze radar-ostacolo differenti, valutando l'accuratezza di diversi modelli di machine learning.": "The study analyzes human detection in non-line-of-sight (NLOS) conditions using ultra-wideband radar, through a measurement campaign in real environments with different body orientations, obstacle materials, and radar-obstacle distances, evaluating the accuracy of different machine learning models."
          };
          const translatedAbstract = abstractTranslations[pub.abstract] || pub.abstract;
          const translatedTitle = pub.title.includes("ricerca e pubblicazione") ? pub.title.replace("ricerca e pubblicazione", "Research and Publication") : pub.title;
          return (
            <a class="card publication-card" href={pub.url} target="_blank" rel="noopener noreferrer">
              <p class="publication-journal"><Icon name="paper" /> {pub.journal} · {pub.date}</p>
              <h3 class="publication-title">{translatedTitle}</h3>
              <p class="publication-abstract">{translatedAbstract}</p>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <CtaBand
    title="Ready to work together?"
    text="Whether you need software development, technical consulting, or training, I'm available for project-based collaborations."
    primary={{ href: "/en/contact/", label: "Get in touch" }}
    secondary={{ href: "/cv-federico-di-luca.pdf", label: "Download CV", icon: "download" }}
  />
</BaseLayout>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: 3rem;
    align-items: center;
  }

  .about-text {
    color: var(--color-text-muted);
  }

  .highlights {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .highlight {
    padding: 1.35rem;
  }

  .highlight-title {
    font-weight: 700;
    margin: 0.9rem 0 0.3rem;
  }

  .highlight-text {
    color: var(--color-text-muted);
    font-size: 0.88rem;
    line-height: 1.5;
    margin: 0;
  }

  .narrow p {
    color: var(--color-text-muted);
  }

  .section-alt {
    background: var(--color-bg-alt);
  }

  .publication-card {
    display: block;
    color: var(--color-text);
  }

  .publication-journal {
    color: var(--color-link);
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    margin: 0 0 0.5rem;
  }

  .publication-title {
    margin: 0;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .service-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1.5rem;
  }

  .service-icon {
    margin-bottom: 1rem;
  }

  .service-card h3 {
    color: var(--color-text);
    margin-top: 0;
    margin-bottom: 0.75rem;
  }

  .service-card p {
    color: var(--color-text-muted);
    margin: 0;
  }

  @media (max-width: 720px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
