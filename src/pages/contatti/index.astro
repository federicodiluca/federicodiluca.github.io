---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import { AUTHOR, SHOW_PRIVATE_LESSONS } from "../../consts";
import Icon from "../../components/Icon.astro";

const description = `Contatta Federico Di Luca per progetti di sviluppo software, consulenza tecnica, formazione o ${
  SHOW_PRIVATE_LESSONS ? "lezioni private" : "corsi su misura"
} a Pesaro, Fano, Urbino e Rimini.`;

// Il mailto pre-compila oggetto e traccia del messaggio: chi scrive trova già la struttura,
// senza che il sito raccolga o inoltri alcun dato a terzi.
const mailSubject = encodeURIComponent("Richiesta di contatto dal sito");
const mailBody = encodeURIComponent(
  `Ciao Federico,\n\nti scrivo per: [sviluppo software / consulenza / formazione / ${
    SHOW_PRIVATE_LESSONS ? "lezioni private" : "corso su misura"
  }]\n\nIn breve:\n\n\nGrazie,\n`,
);
const mailHref = `mailto:${AUTHOR.email}?subject=${mailSubject}&body=${mailBody}`;
---

<BaseLayout title="Contatti" description={description}>
  <PageHeader
    eyebrow="Pesaro · Fano · Urbino · Rimini · da remoto"
    title="Contatti"
    lead="Raccontami il tuo progetto o la tua esigenza formativa: ti risponderò via email."
    icons={["mail", "pin", "spark"]}
  />

  <section class="section">
    <div class="container contact-grid">
      <div class="card contact-main">
        <Icon name="mail" badge class="contact-icon" />
        <p class="contact-label">Scrivimi a</p>
        <a class="contact-email" href={`mailto:${AUTHOR.email}`}>{AUTHOR.email}</a>
        <p class="contact-hint">
          Copia l'indirizzo e scrivimi dal tuo servizio di posta preferito. Se hai un client di posta
          configurato, il secondo pulsante lo apre con oggetto e traccia del messaggio già pronti.
        </p>
        <div class="contact-actions">
          <button class="btn btn-primary" type="button" data-copy-email={AUTHOR.email}>
            Copia indirizzo
          </button>
          <a class="btn btn-outline" href={mailHref}>Apri client di posta</a>
        </div>
      </div>

      <div class="card contact-side">
        <h2 class="card-title">Altri canali</h2>
        <div class="contact-links">
          <a href={AUTHOR.sameAs[1]} target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <a href={AUTHOR.sameAs[0]} target="_blank" rel="noopener noreferrer">GitHub</a>
        </div>
        <p class="contact-area">
          <Icon name="pin" />
          Area operativa: Pesaro, Fano, Urbino, Rimini — disponibile anche da remoto per progetti da
          tutta Italia.
        </p>
        <p class="contact-privacy">
          <Icon name="shield" />
          Questo sito non raccoglie dati: scrivendomi, la tua email resta solo nella mia casella di
          posta. <a href="/privacy/">Informativa privacy</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: 2rem;
    align-items: start;
  }

  .contact-main {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .contact-icon {
    margin-bottom: 0.75rem;
  }

  .contact-label {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .contact-email {
    font-size: clamp(1.2rem, 3vw, 1.6rem);
    font-weight: 700;
    color: var(--color-text);
    word-break: break-all;
  }

  .contact-hint {
    color: var(--color-text-muted);
    margin: 0.75rem 0 1rem;
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .contact-actions .btn {
    font-family: inherit;
    font-size: inherit;
    cursor: pointer;
  }

  /* Stato "copiato": il pulsante diventa la conferma stessa, senza toast o layout shift */
  .contact-actions .btn[data-copied="true"] {
    background: var(--color-accent-hover);
    color: #fff;
  }

  .card-title {
    margin-top: 0;
  }

  .contact-links {
    display: flex;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .contact-area,
  .contact-privacy {
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }

  .contact-privacy {
    margin-bottom: 0;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }

  @media (max-width: 780px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // "Copia indirizzo" funziona ovunque, a differenza del mailto che richiede un client
  // di posta configurato nel browser (chi usa solo la webmail spesso non ce l'ha).
  document.querySelectorAll<HTMLButtonElement>("[data-copy-email]").forEach((btn) => {
    const email = btn.dataset.copyEmail || "";
    const label = btn.textContent;

    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(email);
        btn.textContent = "Copiato!";
        btn.dataset.copied = "true";
      } catch {
        // Clipboard non disponibile (contesto non sicuro o permesso negato):
        // si seleziona l'indirizzo visibile, così basta Ctrl+C.
        const link = document.querySelector(".contact-email");
        if (link) window.getSelection()?.selectAllChildren(link);
        btn.textContent = "Seleziona e copia";
      }
      setTimeout(() => {
        btn.textContent = label;
        delete btn.dataset.copied;
      }, 2200);
    });
  });
</script>
