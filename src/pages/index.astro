---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Timeline from "../components/Timeline.astro";
import SkillsGrid from "../components/SkillsGrid.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Icon from "../components/Icon.astro";
import { experiences, experiencesFooter, education, publications, aboutMessages, projects } from "../data/site-data";
import { SITE_URL, AUTHOR } from "../consts";

const description =
  "Sviluppatore software freelance (.NET, C#, Python) e docente di Informatica. Lezioni private, ripetizioni e formazione tecnica a Pesaro, Fano, Urbino, Rimini.";

// Lavoro e studi in un'unica timeline, dalla voce più recente.
const path = [
  ...experiences.map((e) => ({
    kind: "work" as const,
    start: e.start,
    title: e.role,
    subtitle: e.company,
    date: e.date,
  })),
  ...education.map((e) => ({
    kind: "education" as const,
    start: e.start,
    title: `${e.title} in ${e.subTitle}`,
    subtitle: e.institute,
    meta: `Voto: ${e.mark}`,
    date: e.date,
    steps: e.steps.map((s) => ({ title: s.title, subtitle: s.institute, meta: s.note, date: s.date })),
  })),
].sort((a, b) => b.start.localeCompare(a.start));

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: `${AUTHOR.name} — Sviluppo Software & Lezioni Private`,
  url: SITE_URL,
  image: new URL("/images/social-share.jpg", SITE_URL).toString(),
  areaServed: AUTHOR.serviceArea,
  founder: { "@type": "Person", name: AUTHOR.name },
  address: {
    "@type": "PostalAddress",
    addressLocality: AUTHOR.city,
    addressRegion: AUTHOR.region,
    addressCountry: AUTHOR.country,
  },
};
---

<BaseLayout title="Sviluppatore Software & Docente di Informatica" description={description} jsonLd={jsonLd}>
  <Hero
    eyebrow="Pesaro · Fano · Urbino · Rimini"
    title="Sviluppatore Software & Docente di Informatica"
    tagline="Sviluppo software freelance, lezioni private, ripetizioni STEM e formazione tecnica per aziende, scuole e privati."
    primaryCta={{ href: "/contatti/", label: "Contattami", icon: "mail" }}
    secondaryCta={{ href: "/cv-federico-di-luca.pdf", label: "Scarica il CV", icon: "download" }}
  />

  <section class="section section-alt" id="progetti" data-animate>
    <div class="container">
      <h2 class="section-title">Progetti</h2>
      <p class="section-lead">
        Cose che ho costruito partendo da un bisogno reale, e che chiunque può usare o ispezionare:
        il codice è pubblico.
      </p>
      <div class="projects-grid">
        {projects.map((project) => <ProjectCard {...project} compact />)}
      </div>
      <a class="btn btn-outline projects-more" href="/progetti/">Tutti i progetti</a>
    </div>
  </section>

  <section class="section" id="aboutme" data-animate>
    <div class="container about-grid">
      <div>
        <h2 class="section-title">Chi sono</h2>
        {aboutMessages.map((message) => (
          <p class="about-text">{message}</p>
        ))}
        <p class="about-text">
          Offro lezioni private di informatica, matematica e fisica a studenti di scuole medie, superiori e università. Dispongo anche di competenze in analisi di dati, machine learning e sviluppo di sistemi SCADA per automazione industriale.
        </p>
        <a class="btn btn-outline" href="/chi-sono/">Scopri di più su di me</a>
      </div>
      <img
        src="/images/federico-di-luca.webp"
        alt="Federico Di Luca"
        width="320"
        height="320"
        class="about-photo"
      />
    </div>
  </section>

  <section class="section section-alt" id="servizi" data-animate>
    <div class="container">
      <h2 class="section-title">Cosa faccio</h2>
      <p class="section-lead">
        Tre modi di lavorare insieme, tra le province di Pesaro-Urbino, Rimini o da remoto.
      </p>
      <div class="services-grid">
        <a class="card service-card" href="/servizi/sviluppo-software/">
          <Icon name="code" badge class="service-icon" />
          <h3>Sviluppo software</h3>
          <p>
            Applicazioni .NET e Python, integrazioni tra sistemi, automazione e supporto tecnico
            ai team di sviluppo.
          </p>
          <span class="service-link">Vedi i servizi →</span>
        </a>
        <a class="card service-card" href="/servizi/formazione/">
          <Icon name="board" badge class="service-icon" />
          <h3>Formazione</h3>
          <p>
            Corsi di programmazione e informatica per aziende e scuole, dall'alfabetizzazione
            digitale alle tecnologie di sviluppo.
          </p>
          <span class="service-link">Vedi i percorsi →</span>
        </a>
        <a class="card service-card" href="/lezioni-private/">
          <Icon name="book" badge class="service-icon" />
          <h3>Lezioni private</h3>
          <p>
            Ripetizioni di informatica, matematica e fisica per studenti di scuole medie, superiori e
            università, in presenza o online.
          </p>
          <span class="service-link">Come funzionano →</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section" id="percorso" data-animate>
    <div class="container">
      <h2 class="section-title">Percorso</h2>
      <p class="section-lead">Dall'ingegneria allo sviluppo software, fino all'insegnamento.</p>
      <Timeline items={path} legend={{ work: "Lavoro", education: "Studi" }} />
      <p class="experiences-footer">{experiencesFooter}</p>
    </div>
  </section>

  <section class="section section-alt" data-animate>
    <div class="container">
      <h2 class="section-title">Strumenti principali</h2>
      <SkillsGrid />
    </div>
  </section>

  <section class="section" data-animate>
    <div class="container">
      <h2 class="section-title">Pubblicazioni scientifiche</h2>
      {publications.map((pub) => (
        <a class="card publication-card" href={pub.url} target="_blank" rel="noopener noreferrer">
          <p class="publication-journal"><Icon name="paper" /> {pub.journal} · {pub.date}</p>
          <h3 class="publication-title">{pub.title}</h3>
          <p class="publication-abstract">{pub.abstract}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="section cta-section" data-animate>
    <div class="container cta-inner">
      <Icon name="rocket" badge class="cta-icon" />
      <h2 class="section-title">Hai un progetto in mente?</h2>
      <p class="section-lead">
        Sviluppo software, consulenza tecnica o formazione: scrivimi per parlarne.
      </p>
      <a class="btn btn-primary" href="/contatti/">Contattami</a>
    </div>
  </section>
</BaseLayout>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  .about-text {
    color: var(--color-text-muted);
  }

  .about-photo {
    border-radius: var(--radius);
    width: 100%;
    max-width: 320px;
    margin: 0 auto;
  }

  .section-alt {
    background: var(--color-bg-alt);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .projects-more {
    margin-top: 2rem;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .service-card {
    display: flex;
    flex-direction: column;
    color: var(--color-text);
  }

  .service-card:hover {
    text-decoration: none;
    border-color: var(--color-accent-2);
  }

  .service-icon {
    margin-bottom: 1rem;
  }

  .service-card h3 {
    margin: 0 0 0.6rem;
    font-size: 1.15rem;
  }

  .service-card p {
    color: var(--color-text-muted);
    margin: 0 0 1.25rem;
    flex-grow: 1;
  }

  .service-link {
    color: var(--color-accent-2);
    font-weight: 600;
    font-size: 0.9rem;
    margin-top: auto;
  }

  .experiences-footer {
    margin-top: 2rem;
    color: var(--color-text-muted);
    font-size: 0.85rem;
    line-height: 1.8;
  }

  .publication-card {
    display: block;
    color: var(--color-text);
  }

  .publication-card:hover {
    text-decoration: none;
    border-color: var(--color-accent-2);
  }

  .publication-journal {
    color: var(--color-accent-2);
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: 0 0 0.5rem;
  }

  .publication-title {
    margin: 0 0 0.75rem;
    font-size: 1.15rem;
  }

  .publication-abstract {
    color: var(--color-text-muted);
    margin: 0;
  }

  .cta-section {
    text-align: center;
  }

  .cta-icon {
    width: 4rem;
    height: 4rem;
    font-size: 2.2rem;
    margin-bottom: 1.25rem;
  }

  .cta-inner .section-title {
    margin-bottom: 0.5rem;
  }

  .cta-inner .section-lead {
    margin: 0 auto 2rem;
  }

  @media (max-width: 720px) {
    .about-grid {
      grid-template-columns: 1fr;
    }

    .about-photo {
      order: -1;
    }
  }
</style>
